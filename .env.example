# Vercel KV (Redis) for signaling storage
# In production: Automatically provided by Vercel when you add a KV store
# For local development: Copy these from your Vercel project settings → Storage → KV → .env.local
#                        Create .env.local and paste the values to use KV locally
#                        If not set, falls back to in-memory storage
#
# Option 1: Direct Redis connection (Vercel typically sets REDIS_URL)
# REDIS_URL="redis://default:password@host:port"
# KV_URL="redis://default:password@host:port"  # Alternative name
#
# Option 2: REST API (if using Vercel KV REST API)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Metered TURN server API key
# Get your API key from: https://dashboard.metered.ca/
# METERED_API_KEY="your-api-key-here"
